  "tools": [
    {
      "id": "call-in",
      "name": "Call-in · 簡單叩應",
      "summary": "在既有簡報旁加入 QR code、難度回饋、提問、反應與投票，適合現場或混合活動。",
      "url": "https://call-in.mashbean.net/",
      "source": "https://github.com/mashbean/call-in",
      "status": "integrated",
      "stages": ["evaluating", "eliciting", "deliberating"],
      "goals": ["listen", "understand", "followup"],
      "formats": ["hybrid", "online", "offline"],
      "scales": ["small", "medium"],
      "privacy": ["public", "pseudonymous"],
      "outputs": ["questions", "insights", "receipt"],
      "hosting": "hosted-or-cloudflare",
      "deploy": "https://deploy.workers.cloudflare.com/?url=https://github.com/mashbean/call-in",
      "handoff": "管理者 JSON export；下一步是 delib-bundle 轉換器。"
    },
    {
      "id": "openbook",
      "name": "OpenBook 臺灣開放預算",
      "summary": "把官方地方政府預算、OpenFun 與資料介面整理成可追溯的證據與公開成果頁。",
      "url": "https://mashbean.github.io/Open-Book/",
      "source": "https://github.com/mashbean/Open-Book",
      "status": "integrated",
      "stages": ["evaluating", "agenda-setting", "learning", "actuating"],
      "goals": ["evidence", "propose", "decide"],
      "formats": ["hybrid", "online", "offline"],
      "scales": ["small", "medium", "large"],
      "privacy": ["public"],
      "outputs": ["evidence", "proposals", "receipt"],
      "hosting": "static-publication",
      "handoff": "CSV/XLSX 匯入、CSV 與靜態資料輸出；適合作為證據來源而非參與者資料庫。"
    },
    {
      "id": "uncommon-ground",
      "name": "Uncommon Ground",
      "summary": "把完整問題池整理成一條演講／回覆弧線，逐一回覆每位提問者並發布雙語 closed-loop receipt。",
      "url": "https://github.com/audreyt/uncommon-ground",
      "source": "https://github.com/audreyt/uncommon-ground",
      "status": "integrated",
      "stages": ["learning", "deliberating", "actuating", "reflecting"],
      "goals": ["understand", "followup", "listen"],
      "formats": ["hybrid", "online", "offline"],
      "scales": ["medium", "large"],
      "privacy": ["public", "pseudonymous", "sensitive"],
      "outputs": ["questions", "insights", "receipt"],
      "hosting": "local-scripts-and-agent-skill",
      "handoff": "questions/clusters/arc/takes/loopbacks/meta JSON 與 verify.py。敏感資料必須在本機或核准環境處理。"
    },
    {
      "id": "polis",
      "name": "Pol.is",
      "summary": "以陳述與同意／不同意投票呈現意見群體、共識與分歧，適合大規模非同步聆聽。",
      "url": "https://pol.is/",
      "source": "https://github.com/compdemocracy/polis",
