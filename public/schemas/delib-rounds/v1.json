{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://delib.mashbean.net/schemas/delib-rounds/v1.json",
  "title": "Delib iterative rounds bundle v1",
  "description": "A versioned companion to delib-data/v1 retaining cross-round source provenance, participant presence, online/in-person modes, facilitation gates and next-round commitments. A CSV alone is not a complete round. Real participant-linked bundles are private; synthetic status is never inferred.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "id",
    "generatedAt",
    "simulated",
    "issue",
    "disclaimer",
    "participants",
    "rounds",
    "dataCard"
  ],
  "properties": {
    "schema": {
      "const": "https://delib.mashbean.net/schemas/delib-rounds/v1.json"
    },
    "kind": {
      "const": "delib-rounds-bundle"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:_./-]{0,119}$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "simulated": {
      "type": "boolean"
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/localized"
        },
        "description": {
          "$ref": "#/$defs/localized"
        }
      }
    },
    "disclaimer": {
      "$ref": "#/$defs/localized"
    },
    "participants": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/participant"
      }
    },
    "rounds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/round"
      }
    },
    "dataCard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "containsParticipantData",
        "containsDirectIdentifiers",
        "containsPseudonymousLinkage",
        "suitableForPublicSharing",
        "publicationStatus",
        "simulationOnly",
        "limitations"
      ],
      "properties": {
        "containsParticipantData": {
          "type": "boolean"
        },
        "containsDirectIdentifiers": {
          "const": false
        },
        "containsPseudonymousLinkage": {
          "type": "boolean"
        },
        "suitableForPublicSharing": {
          "type": "boolean"
        },
        "publicationStatus": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "simulationOnly": {
          "type": "boolean"
        },
        "limitations": {
          "$ref": "#/$defs/localized"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "simulated": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "dataCard": {
            "properties": {
              "suitableForPublicSharing": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "simulated": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "participants": {
            "items": {
              "properties": {
                "simulated": {
                  "const": true
                }
              }
            }
          },
          "rounds": {
            "items": {
              "properties": {
                "artifacts": {
                  "items": {
                    "properties": {
                      "simulated": {
                        "const": true
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "localized": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zh",
        "en"
      ],
      "properties": {
        "zh": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "perspective",
        "simulated"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:_./-]{0,119}$"
        },
        "label": {
          "$ref": "#/$defs/localized"
        },
        "perspective": {
          "$ref": "#/$defs/localized"
        },
        "simulated": {
          "type": "boolean"
        }
      }
    },
    "attendance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participantRef",
        "mode"
      ],
      "properties": {
        "participantRef": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:_./-]{0,119}$"
        },
        "mode": {
          "enum": [
            "online",
            "in-person"
          ]
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "phaseId",
        "kind",
        "text",
        "source",
        "participantRef",
        "derivedFrom",
        "status",
        "reviewed",
        "simulated"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:_./-]{0,119}$"
        },
        "phaseId": {
          "enum": [
            "frame",
            "recruit",
            "sortition",
            "learn",
            "listen",
            "deliberate",
            "respond",
            "feedback"
          ]
        },
        "kind": {
          "enum": [
            "brief",
            "statement",
            "question",
            "inclusion-check",
            "theme",
            "proposal",
            "reply",
            "decision",
            "feedback"
          ]
        },
        "text": {
          "$ref": "#/$defs/localized"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tool",
            "sourceId",
            "artifactId"
          ],
          "properties": {
            "tool": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "sourceId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:_./-]{0,119}$"
            },
            "artifactId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:_./-]{0,119}$"
            }
          }
        },
        "participantRef": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:_./-]{0,119}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "derivedFrom": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:_./-]{0,119}$"
          }
        },
        "status": {
          "enum": [
            "draft",
            "reviewed",
            "needs-response"
          ]
        },
        "reviewed": {
          "type": "boolean"
        },
        "simulated": {
          "type": "boolean"
        }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mode",
        "participantRefs",
        "tools",
        "inputRefs",
        "outputRefs",
        "input",
        "output",
        "guidance"
      ],
      "properties": {
        "id": {
          "enum": [
            "frame",
            "recruit",
            "sortition",
            "learn",
            "listen",
            "deliberate",
            "respond",
            "feedback"
          ]
        },
        "mode": {
          "enum": [
            "online",
            "in-person",
            "hybrid"
          ]
        },
        "participantRefs": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:_./-]{0,119}$"
          }
        },
        "tools": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "inputRefs": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:_./-]{0,119}$"
          }
        },
        "outputRefs": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:_./-]{0,119}$"
          }
        },
        "input": {
          "$ref": "#/$defs/localized"
        },
        "output": {
          "$ref": "#/$defs/localized"
        },
        "guidance": {
          "$ref": "#/$defs/localized"
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "phaseId",
        "itemRef",
        "participantRef",
        "value",
        "tool"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:_./-]{0,119}$"
        },
        "phaseId": {
          "enum": [
            "frame",
            "recruit",
            "sortition",
            "learn",
            "listen",
            "deliberate",
            "respond",
            "feedback"
          ]
        },
        "itemRef": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:_./-]{0,119}$"
        },
        "participantRef": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:_./-]{0,119}$"
        },
        "value": {
          "enum": [
            "agree",
            "disagree",
            "pass"
          ]
        },
        "tool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "next": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phaseId",
        "reason",
        "owner",
        "reviewOn",
        "carryForwardRefs"
      ],
      "properties": {
        "phaseId": {
          "enum": [
            "frame",
            "recruit",
            "sortition",
            "learn",
            "listen",
            "deliberate",
            "respond",
            "feedback"
          ]
        },
        "reason": {
          "$ref": "#/$defs/localized"
        },
        "owner": {
          "$ref": "#/$defs/localized"
        },
        "reviewOn": {
          "type": "string",
          "format": "date"
        },
        "carryForwardRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:_./-]{0,119}$"
          }
        }
      }
    },
    "round": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sequence",
        "previousRoundId",
        "title",
        "goal",
        "focus",
        "attendance",
        "phases",
        "artifacts",
        "responses",
        "next"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:_./-]{0,119}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "previousRoundId": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:_./-]{0,119}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "$ref": "#/$defs/localized"
        },
        "goal": {
          "$ref": "#/$defs/localized"
        },
        "focus": {
          "$ref": "#/$defs/localized"
        },
        "attendance": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/attendance"
          }
        },
        "phases": {
          "type": "array",
          "minItems": 8,
          "items": {
            "$ref": "#/$defs/phase"
          },
          "maxItems": 8
        },
        "artifacts": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "responses": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/response"
          }
        },
        "next": {
          "$ref": "#/$defs/next"
        }
      }
    }
  }
}
