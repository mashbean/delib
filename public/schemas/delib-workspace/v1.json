{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://delib.mashbean.net/schemas/delib-workspace/v1.json",
  "title": "Delib local issue workspace v1",
  "description": "Private local projects. Companion to delib-rounds; not an ecosystem standard. Management credentials are excluded. Imports also require graph and size validation in workspace-core.js. Optional facilitation extensions preserve commitment, disposition and participation histories independently of text review. Older v1 backups remain valid. Optional transfers preserve scoped source snapshots and observed delivery history. Runtime validates graph links and lifecycle. Optional native imports preserve typed method data and file observations; they are not remote delivery receipts. Context fields and typed optional extensions are declared explicitly. Missing legacy context is reported by the contract inspector, never fabricated. Browser and CLI additionally run the same graph/lifecycle validator.",
  "type": "object",
  "required": [
    "schema",
    "id",
    "title",
    "language",
    "simulated",
    "rounds",
    "events",
    "view"
  ],
  "properties": {
    "schema": {
      "const": "https://delib.mashbean.net/schemas/delib-workspace/v1.json"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "language": {
      "enum": [
        "zh",
        "en"
      ]
    },
    "simulated": {
      "type": "boolean"
    },
    "rounds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/round"
      }
    },
    "events": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "required": [
          "type",
          "recordId",
          "by",
          "at"
        ],
        "properties": {
          "type": {
            "enum": [
              "revision",
              "review",
              "reopen"
            ]
          },
          "recordId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "by": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "view": {
      "type": "object",
      "required": [
        "roundId",
        "tab",
        "selected"
      ],
      "properties": {
        "roundId": {
          "type": "string"
        },
        "tab": {
          "enum": [
            "route",
            "voices",
            "changes",
            "participation",
            "transfer",
            "flow"
          ]
        },
        "selected": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "focus",
            "overview"
          ]
        },
        "flowVoice": {
          "type": "string",
          "description": "Optional selected source record; empty means current round."
        }
      }
    },
    "transfers": {
      "type": "array",
      "maxItems": 300,
      "items": {
        "$ref": "/schemas/delib-workspace-transfer/v1.json"
      }
    },
    "imports": {
      "type": "array",
      "maxItems": 150,
      "items": {
        "$ref": "/schemas/delib-workspace-import/v1.json"
      }
    },
    "metagov": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "namespace",
        "actors"
      ],
      "properties": {
        "schema": {
          "const": "delib-metagov-mapping/v1"
        },
        "namespace": {
          "type": "string",
          "format": "uuid"
        },
        "actors": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "label",
              "algorithmKind",
              "evidence",
              "at"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "kind": {
                "enum": [
                  "Participant",
                  "Host",
                  "Algorithm"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "algorithmKind": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 200
              },
              "evidence": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "description": "Purpose of this issue. Optional only for legacy v1 backups; new projects supply this."
    },
    "audience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Intended participants, not an assertion of actual representation."
    },
    "deadline": {
      "type": "string",
      "format": "date",
      "description": "Review deadline; not a Phase start or end timestamp."
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "replay": {
      "type": "object",
      "required": [
        "id",
        "revision"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      },
      "description": "Provenance of an explicitly simulated public-data rehearsal."
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "text",
        "source",
        "derivedFrom",
        "relations",
        "participantRef",
        "supersedes",
        "review"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "kind": {
          "enum": [
            "statement",
            "question",
            "theme",
            "proposal",
            "reply",
            "decision",
            "feedback",
            "brief",
            "inclusion-check",
            "method-result",
            "quote"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "source": {
          "type": "object",
          "required": [
            "tool",
            "id"
          ],
          "properties": {
            "tool": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        },
        "derivedFrom": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ref",
              "type"
            ],
            "properties": {
              "ref": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "derived",
                  "responds",
                  "revises",
                  "supports",
                  "opposes",
                  "context"
                ]
              }
            }
          }
        },
        "participantRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "supersedes": {
          "type": [
            "string",
            "null"
          ]
        },
        "review": {
          "type": "object",
          "required": [
            "checked",
            "reviewer",
            "at",
            "quoteConfirmed"
          ],
          "properties": {
            "checked": {
              "type": "boolean"
            },
            "reviewer": {
              "type": "string"
            },
            "at": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "string",
                  "format": "date-time"
                }
              ],
              "description": "Legacy reviews may record only a date; preserve that precision instead of inventing a time."
            },
            "quoteConfirmed": {
              "type": "boolean"
            }
          }
        },
        "commitments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 60,
          "items": {
            "$ref": "#/$defs/commitment"
          }
        },
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 60,
          "items": {
            "$ref": "#/$defs/disposition"
          }
        },
        "nativeRef": {
          "type": "object",
          "required": [
            "importId",
            "recordId"
          ],
          "additionalProperties": false,
          "properties": {
            "importId": {
              "type": "string"
            },
            "recordId": {
              "type": "string"
            }
          }
        },
        "settingHistory": {
          "type": "array",
          "minItems": 1,
          "maxItems": 60,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "at",
              "by",
              "setting",
              "note"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "by": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "setting": {
                "enum": [
                  "unknown",
                  "online",
                  "in-person"
                ]
              },
              "note": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            }
          }
        },
        "metagovHistory": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "madeBy",
              "classifiedBy",
              "evidence",
              "at",
              "snapshot"
            ],
            "properties": {
              "role": {
                "enum": [
                  "Question",
                  "Belief",
                  "Fact",
                  "Evidence",
                  "Refutation",
                  "Summary",
                  "Proposal",
                  "Decision"
                ]
              },
              "madeBy": {
                "type": "string",
                "format": "uuid"
              },
              "classifiedBy": {
                "type": "string",
                "format": "uuid"
              },
              "evidence": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "snapshot": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200000
              }
            }
          }
        },
        "context": {
          "type": "string",
          "minLength": 0,
          "maxLength": 12000
        },
        "methodData": {
          "type": "object",
          "description": "Typed method results; not participant testimony."
        },
        "sourceEvidence": {
          "type": "object",
          "description": "Source-specific provenance, not inferred identity or consent."
        }
      }
    },
    "round": {
      "type": "object",
      "required": [
        "id",
        "title",
        "step",
        "artifacts",
        "inputs",
        "connections",
        "next"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "step": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record"
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "connections": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "id",
              "inputRefs",
              "contextRefs"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]{10}$"
              },
              "status": {
                "type": "string"
              },
              "inputRefs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "contextRefs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "transferId": {
                "type": "string",
                "maxLength": 120
              }
            }
          },
          "propertyNames": {
            "enum": [
              "form",
              "tttc",
              "reply"
            ]
          }
        },
        "next": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "reason",
            "owner",
            "date",
            "carryForwardRefs"
          ],
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "owner": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "date": {
              "type": "string",
              "format": "date"
            },
            "phase": {
              "enum": [
                "recruit",
                "learn",
                "deliberate",
                "respond"
              ]
            },
            "carryForwardRefs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            }
          }
        },
        "participation": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/participationGap"
          }
        }
      }
    },
    "commitment": {
      "type": "object",
      "required": [
        "id",
        "by",
        "at",
        "owner",
        "reviewOn",
        "status",
        "note",
        "authorityConfirmed"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "format": "date-time"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "reviewOn": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "status": {
          "enum": [
            "draft",
            "confirmed",
            "committed",
            "piloting",
            "review-due",
            "closed"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "authorityConfirmed": {
          "type": "boolean"
        }
      }
    },
    "disposition": {
      "type": "object",
      "required": [
        "id",
        "by",
        "at",
        "owner",
        "reviewOn",
        "status",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "format": "date-time"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "reviewOn": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "status": {
          "enum": [
            "pending",
            "adopted",
            "deferred",
            "not-adopted"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "participationEntry": {
      "type": "object",
      "required": [
        "id",
        "by",
        "at",
        "owner",
        "reviewOn",
        "status",
        "group",
        "barrier",
        "action",
        "note"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "format": "date-time"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "reviewOn": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "status": {
          "enum": [
            "missing",
            "invited",
            "heard",
            "follow-up"
          ]
        },
        "group": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "barrier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "participationGap": {
      "type": "object",
      "required": [
        "id",
        "history"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "carriedFrom": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "history": {
          "type": "array",
          "minItems": 1,
          "maxItems": 60,
          "items": {
            "$ref": "#/$defs/participationEntry"
          }
        }
      }
    }
  }
}
