{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "delib",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "exports": {
    "RankingRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RANKING_ROOMS",
        "class_name": "RankingRoom"
      }
    ]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": false
  },
  "vars": {
    "CALL_IN_ORIGIN": "https://call-in.mashbean.net"
  },
  "env": {
    "production": {
      "name": "delib",
      "durable_objects": {
        "bindings": [
          {
            "name": "RANKING_ROOMS",
            "class_name": "RankingRoom"
          }
        ]
      },
      "vars": {
        "CALL_IN_ORIGIN": "https://call-in.mashbean.net"
      },
      "routes": [
        {
          "pattern": "delib.mashbean.net",
          "custom_domain": true
        }
      ]
    }
  }
}
