{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "delib",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-30",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": false
  },
  "vars": {
    "CALL_IN_ORIGIN": "https://call-in.mashbean.net"
  },
  "env": {
    "production": {
      "name": "delib",
      "vars": {
        "CALL_IN_ORIGIN": "https://call-in.mashbean.net"
      },
      "routes": [
        {
          "pattern": "delib.mashbean.net",
          "custom_domain": true
        }
      ]
    }
  }
}
